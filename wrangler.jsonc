{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "event-go",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },

  // 二维码和分享链接里的绝对地址。换自有域名后改这里并重新部署，
  // 否则已经发出去的码还指向旧地址。
  "vars": {
    "SE_PUBLIC_ORIGIN": "https://event-go.junwei-jay-li.workers.dev"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  // 活动报名的图片（封面、更新配图）默认存 D1。在 Cloudflare 开通 R2 后，
  // 把下面这段取消注释就会自动改走 R2（已在 D1 的旧图继续可读）：
  // "r2_buckets": [{ "binding": "SE_MEDIA", "bucket_name": "event-go-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "event-go",
      "database_id": "02c58845-08c1-4e6e-9b97-b2ed44b7cee4"
    }
  ]
}
